# Nuxt 标准环境变量：NUXT_ 前缀自动映射到 runtimeConfig（见 nuxt.config.ts）
# NUXT_DB_HOST → runtimeConfig.dbHost，NUXT_CDM_SECRET_KEY → cdmSecretKey ...

# ---- MySQL ----
NUXT_DB_HOST=127.0.0.1
NUXT_DB_PORT=3306
NUXT_DB_USER=root
NUXT_DB_PASSWORD=
NUXT_DB_NAME=colab_down

# ---- 安全 ----
# AES-256-GCM 密钥（32 字节 base64）。生成: openssl rand -base64 32
# 生产环境务必更换！凭据加密与登录 token 签名都依赖它。
# 不要使用任何示例/默认值：下面的值只是占位符，直接照抄等于没有密钥，
# 务必替换为上面命令随机生成的值（未设置时服务端会拒绝加解密操作）。
NUXT_CDM_SECRET_KEY=__REPLACE_WITH_OPENSSL_RAND_BASE64_32_OUTPUT__

# ---- Colab CLI ----
NUXT_COLAB_BIN=colab
# 必须显式指定（实测默认 oauth2，不要依赖默认值）
NUXT_COLAB_AUTH=oauth2

# ---- Mock 模式：1 时不调用真实 colab CLI ----
NUXT_CDM_MOCK=1

# ---- 本地挂载的 Drive 根目录（可选）----
# 用 rclone 等把 Google Drive 挂到本地后填挂载点路径，例如 NUXT_CDM_LOCAL_DRIVE_ROOT=/mnt/gdrive
# 配置后「浏览 Drive / 配额」直接读本地文件系统，不再要求有已挂载 Drive 的 VM；留空走 VM 探测
# NUXT_CDM_LOCAL_DRIVE_ROOT=

# ---- 网络 ----
# 仅本机访问用 127.0.0.1；暴露到局域网改 0.0.0.0（务必设置强登录密码）
NUXT_HOST=127.0.0.1
NUXT_PORT=3000

# ---- 前端显示名（public runtimeConfig，登录页页脚等）----
NUXT_PUBLIC_APP_NAME=Colab Download Manager

# ---- 服务端日志级别（pino：debug|info|warn|error，普通变量不进 runtimeConfig）----
# LOG_LEVEL=info
